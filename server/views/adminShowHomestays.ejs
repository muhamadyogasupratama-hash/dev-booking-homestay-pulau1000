<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Dashboard pengelolaan homestay.">
  <title>Dashboard Admin — Pulau Seribu Stay</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="site-shell">
    <header class="site-header">
      <nav class="nav container" aria-label="Navigasi admin">
        <a href="/admin" class="brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 19h18M5 16l3-5 3 3 4-7 4 9"/><path d="M4 19c3-2 5-2 8 0 3-2 5-2 8 0"/></svg></span><span class="brand-text">Pulau Seribu Stay</span></a>
        <div class="nav-actions"><span class="badge">Admin</span><a href="" class="nav-link">Persetujuan Booking</a><a href="/logout" class="btn btn-secondary btn-sm">Keluar</a></div>
      </nav>
    </header>
    <main class="main-content">
      <div class="container">
        <header class="page-header">
          <div><p class="eyebrow">Dashboard admin</p><h1>Kelola homestay</h1><p class="page-description">Lihat ketersediaan dan perbarui informasi seluruh homestay dari satu tempat.</p></div>
          <a href="/admin/homestays/add" class="btn btn-primary">+ Tambah homestay</a>
        </header>

        <% if (homestays.length) { %>
          <section class="card table-card table-card-bleed" aria-label="Daftar homestay">
            <div class="table-responsive">
              <table>
                <thead><tr><th scope="col">No.</th><th scope="col">Nama homestay</th><th scope="col">Harga / malam</th><th scope="col">Ketersediaan</th><th scope="col">Aksi</th></tr></thead>
                <tbody>
                  <% homestays.forEach((element, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td class="table-primary"><%= element.name %></td>
                      <td><%= element.formattedPrice %></td>
                      <td><span class="badge"><%= element.roomAvailable %> kamar</span></td>
                      <td><div class="table-actions"><a href="/admin/homestays/<%= element.id %>/edit" class="btn btn-edit btn-sm">Edit</a><form action="/admin/homestays/<%= element.id %>/delete" method="POST" onsubmit="return confirm('Yakin ingin menghapus data ini?')"><button type="submit" class="btn btn-danger btn-sm">Hapus</button></form></div></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </section>
        <% } else { %>
          <section class="card empty-state"><div class="empty-state-icon" aria-hidden="true">⌂</div><h2>Belum ada data homestay</h2><p>Tambahkan homestay pertama untuk mulai mengelola daftar.</p><a href="/admin/homestays/add" class="btn btn-primary">Tambah homestay</a></section>
        <% } %>
      </div>
    </main>
    <footer class="site-footer"><div class="container footer-inner"><span>© 2026 Pulau Seribu Stay</span><span>Dashboard pengelolaan homestay</span></div></footer>
  </div>
</body>
</html>

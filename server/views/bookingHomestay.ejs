<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Form booking homestay Pulau Seribu.">
  <title>Booking Homestay — Pulau Seribu Stay</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="site-shell">
    <header class="site-header">
      <nav class="nav container" aria-label="Navigasi utama">
        <a href="/homestays" class="brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 19h18M5 16l3-5 3 3 4-7 4 9"/><path d="M4 19c3-2 5-2 8 0 3-2 5-2 8 0"/></svg></span><span class="brand-text">Pulau Seribu Stay</span></a>
        <div class="nav-actions"><a href="/logout" class="btn btn-secondary btn-sm">Keluar</a></div>
      </nav>
    </header>
    <main class="main-content">
      <div class="container--narrow">
        <section class="card form-card">
          <header class="form-header"><p class="eyebrow">Reservasi homestay</p><h1>Atur jadwal menginap</h1><p>Lengkapi detail booking untuk <strong><%= homestay.name %></strong>.</p></header>
          <form action="/homestays/<%= homestay.id %>/booking" method="POST">
            <div class="form-grid">
              <div class="form-group">
                <label for="checkInDate">Tanggal check-in <span class="required" aria-hidden="true">*</span></label>
                <input type="date" id="checkInDate" name="checkInDate" required>
              </div>
              <div class="form-group">
                <label for="checkOutDate">Tanggal check-out <span class="required" aria-hidden="true">*</span></label>
                <input type="date" id="checkOutDate" name="checkOutDate" required>
              </div>
              <div class="form-group form-group--full">
                <label for="amenityId">Amenity</label>
                <select id="amenityId" name="amenityId">
                  <% amnesty.forEach(el => { %><option value="<%= el.id %>"><%= el.name %></option><% }) %>
                </select>
              </div>
            </div>
            <input type="hidden" name="userId" value="ejsoutUserId">
            <div class="form-actions"><a href="/homestays/<%= homestay.id %>" class="btn btn-secondary">Batal</a><button type="submit" class="btn btn-primary">Konfirmasi booking</button></div>
          </form>
        </section>
      </div>
    </main>
    <footer class="site-footer"><div class="container footer-inner"><span>© 2026 Pulau Seribu Stay</span><span>Temukan nyaman di setiap pulau.</span></div></footer>
  </div>
</body>
</html>

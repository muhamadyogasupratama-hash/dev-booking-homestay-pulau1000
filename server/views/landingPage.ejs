<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Masuk ke aplikasi Booking Homestay Pulau Seribu.">
  <title>Masuk — Pulau Seribu Stay</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <main class="auth-page">
    <section class="auth-visual" aria-label="Tentang Pulau Seribu Stay">
      <a href="/" class="brand auth-brand">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 19h18M5 16l3-5 3 3 4-7 4 9"/><path d="M4 19c3-2 5-2 8 0 3-2 5-2 8 0"/></svg></span>
        <span>Pulau Seribu Stay</span>
      </a>
      <div class="auth-message">
        <p class="eyebrow eyebrow--light">Temukan tempat terbaik</p>
        <h1>Liburan pulau dimulai dari sini.</h1>
        <p>Pilih homestay yang nyaman dan rencanakan waktu istirahatmu dengan lebih mudah.</p>
      </div>
    </section>
    <section class="auth-panel">
      <div class="auth-card">
        <div class="form-header">
          <p class="eyebrow">Selamat datang</p>
          <h1>Masuk ke akunmu</h1>
          <p>Gunakan email dan password yang telah terdaftar.</p>
        </div>
        <% if (errors) { %><div class="alert" role="alert"><%= errors %></div><% } %>
        <form action="/" method="post">
          <div class="form-group"><label for="email">Email</label><input type="text" id="email" name="email" placeholder="nama@email.com" autocomplete="email" required></div>
          <div class="form-group"><label for="password">Password</label><input type="password" id="password" name="password" placeholder="Masukkan password" autocomplete="current-password" required></div>
          <button type="submit" class="btn btn-primary btn-block">Masuk</button>
        </form>
        <p class="auth-footer">Belum punya akun? <a href="/users/register">Daftar sekarang</a></p>
      </div>
    </section>
  </main>
</body>
</html>

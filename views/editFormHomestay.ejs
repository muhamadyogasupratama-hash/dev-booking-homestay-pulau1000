<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Homestay</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f6f9;
      margin: 0;
      padding: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 80vh;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      width: 400px;
    }

    h1 {
      font-size: 22px;
      color: #333;
      text-align: center;
      margin-top: 0;
      margin-bottom: 25px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: bold;
      color: #555;
      margin-bottom: 5px;
    }

    .form-group input {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 4px;
      box-sizing: border-box;
    }

    input[type="submit"] {
      width: 100%;
      padding: 10px;
      background-color: #28a745;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
      margin-top: 10px;
    }

    input[type="submit"]:hover {
      background-color: #218838;
    }

    .btn-back {
      display: block;
      text-align: center;
      background-color: #6c757d;
      color: white;
      padding: 9px;
      text-decoration: none;
      border-radius: 4px;
      margin-top: 10px;
      font-size: 14px;
    }

    .btn-back:hover {
      background-color: #5a6268;
    }
  </style>
</head>

<body>

  <div class="card">

    <h1>Edit Homestay</h1>

    <form action="/admin/homestays/<%= homestay.id %>/edit" method="POST">

      <div class="form-group">
        <label>Nama Homestay:</label>
        <input
          type="text"
          name="name"
          value="<%= homestay.name %>"
          required
        >
      </div>

      <div class="form-group">
        <label>Image URL:</label>
        <input
          type="text"
          name="imageUrl"
          value="<%= homestay.imageUrl %>"
          required
        >
      </div>

      <div class="form-group">
        <label>Harga per Malam:</label>
        <input
          type="number"
          name="pricePerNight"
          value="<%= homestay.pricePerNight %>"
          required
        >
      </div>

      <div class="form-group">
        <label>Kamar Tersedia:</label>
        <input
          type="number"
          name="roomAvailable"
          value="<%= homestay.roomAvailable %>"
          required
        >
      </div>

      <div class="form-group">
        <label>Contact PIC:</label>
        <input
          type="text"
          name="contactPIC"
          value="<%= homestay.contactPIC %>"
          required
        >
      </div>

      <input type="submit" value="Simpan Perubahan">

    </form>

    <a href="/admin" class="btn-back">
      Batal
    </a>

  </div>

</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Buat akun Pulau Seribu Stay.">
  <title>Daftar — Pulau Seribu Stay</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <main class="auth-page">
    <section class="auth-visual" aria-label="Tentang Pulau Seribu Stay">
      <a href="/" class="brand auth-brand">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 19h18M5 16l3-5 3 3 4-7 4 9"/><path d="M4 19c3-2 5-2 8 0 3-2 5-2 8 0"/></svg></span>
        <span>Pulau Seribu Stay</span>
      </a>
      <div class="auth-message">
        <p class="eyebrow eyebrow--light">Mulai perjalananmu</p>
        <h1>Menginap nyaman, pesan tanpa rumit.</h1>
        <p>Buat akun untuk menemukan homestay dan mengatur rencana liburan pulau dalam satu tempat.</p>
      </div>
    </section>
    <section class="auth-panel">
      <div class="auth-card">
        <div class="form-header"><p class="eyebrow">Bergabung</p><h1>Buat akun baru</h1><p>Lengkapi data singkat berikut untuk mulai mencari homestay.</p></div>
        <% if (typeof errors !== 'undefined' && errors) { %>
          <div class="alert" role="alert">
            <% if (Array.isArray(errors)) { %><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul><% } else { %><%= errors %><% } %>
          </div>
        <% } %>
        <form action="/users/register" method="POST">
          <div class="form-group"><label for="name">Nama lengkap</label><input type="text" id="name" name="name" placeholder="Nama lengkapmu" autocomplete="name" required></div>
          <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" placeholder="nama@email.com" autocomplete="email" required></div>
          <div class="form-group"><label for="password">Password</label><input type="password" id="password" name="password" placeholder="Buat password" autocomplete="new-password" required></div>
          <button type="submit" class="btn btn-primary btn-block">Buat akun</button>
        </form>
        <p class="auth-footer">Sudah punya akun? <a href="/">Masuk di sini</a></p>
      </div>
    </section>
  </main>
</body>
</html>

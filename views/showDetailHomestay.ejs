<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Homestay</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f6f9; margin: 0; padding: 40px; display: flex; justify-content: center; align-items: center; min-height: 80vh; }
        
        .detail-card { background: white; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 450px; overflow: hidden; display: flex; flex-direction: column; }
        
        .detail-card img { width: 100%; height: 250px; object-fit: cover; }
        
        .content { padding: 25px; }
        h1 { font-size: 24px; color: #333; margin-top: 0; margin-bottom: 15px; }
        .info-row { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 15px; border-bottom: 1px solid #eee; padding-bottom: 8px; }
        .info-label { font-weight: bold; color: #555; }
        .info-value { color: #333; }
        
        .btn-back { display: block; text-align: center; background-color: #6c757d; color: white; padding: 10px; text-decoration: none; border-radius: 5px; margin-top: 20px; font-weight: bold; }
        .btn-back:hover { background-color: #5a6268; }
    </style>
</head>
<body>

    <div class="detail-card">
            <img src="<%= homestay.imageUrl %>" alt="Foto Homestay">
            
            <div class="content">
                <h1>Detail Informasi Homestay</h1>

                <div class="info-row">
                    <span class="info-label">Harga Per Malam:</span>
                    <span class="info-value" style="color: #28a745; font-weight: bold;"><%= homestay.formattedPrice %></span>
                </div>

                <div class="info-row">
                    <span class="info-label">Kamar Tersedia:</span>
                    <span class="info-value"><%= homestay.roomAvailable %> Kamar</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Kontak PIC:</span>
                    <span class="info-value"><%= homestay.contactPIC %></span>
                </div>

                <a href="/homestays/<%= homestay.id %>/booking" class="btn-back">Booking</a>
                <a href="/homestays" class="btn-back">Kembali ke Daftar</a>
            </div>
    </div>

</body>
</html>